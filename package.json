{
  "name": "@heretek-ai/opencode-harness",
  "version": "1.0.6",
  "description": "Plugin-first OpenCode v2 in-process harness for Muse 1.3: zero-patch Edit/Read/Patch/Shell/Subagent/Retry interceptors, post-formatter FNV-1a anchor resync receipts, cross-file import/export contract verification, atomic multi-file rename_symbol, Dual Direct + Code Mode (tools.harness.*) tools, Hashline edits, AST codemods, PageRank RepoMap, blast-radius & dead-code architecture auditing, atomic transactions, KV-cache-safe context budgeting, permission/taint guards, and DOM geometry auditing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/opencode-harness.git"
  },
  "homepage": "https://github.com/Heretek-AI/opencode-harness",
  "bugs": {
    "url": "https://github.com/Heretek-AI/opencode-harness/issues"
  },
  "author": "Heretek-AI",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "hashline",
    "ast-codemod",
    "permission-guard",
    "circuit-breaker",
    "context-budget",
    "dom-audit",
    "repomap",
    "blast-radius",
    "symbol-references",
    "rename-symbol",
    "muse-1.3"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && npm run build",
    "accept": "bash scripts/accept/run.sh"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.51.0",
    "@axe-core/playwright": "^4.14.0",
    "pi-hashline-readmap": "^0.16.1",
    "playwright": "^1.64.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
